# Optional advanced settings. Provider, models and the Gemini key live in utils.py, not here.

# Parallel model calls (default: 4 for Gemini, OLLAMA_PARALLEL from utils.py for Ollama)
# MA_MAX_PARALLEL=4
# How long Ollama keeps the model loaded between requests
MA_OLLAMA_KEEP_ALIVE=30m
MA_MAX_TOKENS=16000
MA_MAX_RETRIES=5
MA_TIMEOUT_S=900
# 1 = reuse saved Gemini answers for identical requests (.cache/llm)
MA_USE_CACHE=1

# Chunking
MA_CHUNK_WORDS=500
MA_CHUNK_OVERLAP=100

# Retrieval embeddings: auto | ollama | sentence-transformers | tfidf
MA_EMBEDDINGS=auto
MA_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# 1 = run fully offline with placeholder AI output
MA_DEMO=0
